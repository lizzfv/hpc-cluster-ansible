# Managed by Ansible. Do not edit by hand.
ClusterName={{ slurm_cluster_name }}
SlurmctldHost={{ slurm_controller_host }}

SlurmUser=slurm
AuthType=auth/munge
MpiDefault=none
ProctrackType=proctrack/linuxproc
ReturnToService=1
SlurmctldPidFile=/var/run/slurmctld.pid
SlurmdPidFile=/var/run/slurmd.pid
SlurmdSpoolDir=/var/spool/slurmd
StateSaveLocation=/var/spool/slurmctld
TaskPlugin=task/affinity
SrunPortRange={{ slurm_srun_port_start }}-{{ slurm_srun_port_end }}

SchedulerType=sched/backfill
SelectType=select/cons_tres
SelectTypeParameters=CR_Core

AccountingStorageType=accounting_storage/none
JobAcctGatherType=jobacct_gather/none
SlurmctldLogFile=/var/log/slurmctld.log
SlurmdLogFile=/var/log/slurmd.log

{% for host in groups['hpc_compute'] %}
NodeName={{ host }} CPUs={{ slurm_node_cpus }} RealMemory={{ slurm_node_memory_mb }} State=UNKNOWN
{% endfor %}
PartitionName={{ slurm_partition_name }} Nodes={{ groups['hpc_compute'] | join(',') }} Default=YES MaxTime=INFINITE State=UP
